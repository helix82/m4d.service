[Unit]
Description=SynAPI (Synchronous API for CIK-SEP)
After=kafka.service network-online.target

[Service]
Type=simple
TimeoutStartSec=0

WorkingDirectory=/usr/local/synapi

ExecStart=/usr/local/synapi/startup_dev.sh
ExecStop=/bin/kill -15 $MAINPID

Restart=on-abort

User=javadev
Group=javadev
UMask=0007

[Install]
WantedBy=multi-user.target
